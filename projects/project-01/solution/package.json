{
  "name": "knowledge-base",
  "version": "1.0.0",
  "description": "Electron + TypeScript + React knowledge base app with document list and QA panel",
  "main": "dist/main/main.js",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.node.json && vite build",
    "dev": "node scripts/dev.js",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
